{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "byggevaerkstedet-sync",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": false},
  "vars": {"ALLOWED_ORIGINS": "https://niciolajboholt.github.io"},
  "durable_objects": {"bindings": [
    {"name": "ROOMS", "class_name": "LiveRoom"},
    {"name": "ADMISSION", "class_name": "AdmissionGate"}
  ]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["LiveRoom", "AdmissionGate"]}]
}
